# -----------------------------------------------------------------------------
# Inward Outward Register System - Environment Configuration Template
# Copy this file to '.env' and fill in your actual private credentials.
# -----------------------------------------------------------------------------

# Application port (Defaults to 5000)
PORT=5000

# MongoDB Connection String (e.g. local mongodb:// or Atlas mongodb+srv://)
MONGODB_URI=mongodb://localhost:27017/inward_outward

# JSON Web Token secret key (Generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# Runtime environment (development | production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Nodemailer SMTP Email Settings (Required for Forgot Password resets)
# -----------------------------------------------------------------------------

# SMTP Server hostname (e.g. smtp.gmail.com for Gmail, or Mailtrap hostname)
EMAIL_HOST=smtp.gmail.com

# SMTP Server port (e.g. 587 for TLS, or 465 for SSL)
EMAIL_PORT=587

# SMTP account email address (e.g. admin@organization.com)
EMAIL_USER=your_smtp_auth_email@gmail.com

# SMTP account password or app-specific password
EMAIL_PASS=your_smtp_app_password

# Sender display name / sender email envelope
EMAIL_FROM="Inward Outward System"

# -----------------------------------------------------------------------------
# Cloudinary Configuration (For uploaded files)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

